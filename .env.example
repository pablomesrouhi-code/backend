# ─── Nabtalabo — Backend (EasyPanel / Docker) ───
# انسخ إلى متغيرات البيئة في لوحة التحكم. لا ترفع أبداً ملف .env الحقيقي إلى GitHub.

APP_ENV=production

# عناوين عامة (يجب أن تطابق الدومينات الفعلية)
API_BASE_URL=https://api.nabtalabo.store
FRONTEND_URL=https://nabtalabo.store

# إن تركت هذا فارغاً، السيرفر يدمج تلقائياً FRONTEND_URL + دومينات المتجر المعروفة + localhost للتطوير.
# إن عبيت قائمة صريحة، تُستخدم وحدها (وضع صارم — يجب أن تتضمن عناوين التطوير يدوياً أو يُقطع المتجر المحلي والـ LAN).
# CORS_ORIGINS=https://Nabtalabo.store,https://www.Nabtalabo.store,http://localhost:3000,http://127.0.0.1:3000

# EasyPanel: الصق الرابط الداخلي ...
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@nabtalabo_database:5432/nabtalabo?sslmode=disable

# مهلة ثواني لاتصال Postgres (تلقائي غير موجود فالرابط) — تمنع تعليق «alembic upgrade head» بلا حدود
DB_CONNECT_TIMEOUT_SEC=15

SKIP_AUTO_MIGRATE=false

# افتراضياً (فارغ): المهاجرات في الخلفية → /health يجيب فوراً (يقلّل 502 من EasyPanel/Cloudflare).
# للإبقاء على السلوك القديم (انتظار Alembic قبل قبول الطلبات): BACKGROUND_AUTO_MIGRATE=false
BACKGROUND_AUTO_MIGRATE=

# إن فشلت المهاجرة (اتصال/صلاحيات) واللوحة تُسقط الحاوية: مؤقتاً true مع إصلاح DB — ثم احذفه
ALLOW_WEAK_START=false

# إذا EasyPanel يفحص /ready ولا عندكش Postgres سليم — true، أو حسّبي الفحص لـ GET /health
READINESS_LITE=false

# اختياري: diagnostics + إعادة إرسال صف شيت لطلب محفوظ
# GET …/api/diagnostics/database?token=YOUR_TOKEN
# GET …/api/diagnostics/sheet-webhook?token=YOUR_TOKEN
# POST …/api/diagnostics/resend-sheet-row?token=YOUR_TOKEN  body: {"order_number":"NBT-…"} أو {"order_id":"uuid"}
# POST …/api/diagnostics/resend-cod-network-lead?token=YOUR_TOKEN  (نفس body)
DATABASE_DIAGNOSTICS_TOKEN=

# Google Sheets — Web App فقط؛ الصق بعد النشر رابط **`/exec`** من Apps Script هنا أو في SHEET_WEBHOOK_URL (لا تعتمد على Git للقيم الفعلية).
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# SHEET_WEBHOOK_URL=

# ORDERID عمود الشيت — نفس البادئة ديال الطلبات (nabta-…). غيّرها فقط إذا بغيتي بادئة أخرى للشيت
SHEET_ORDER_ID_PREFIX=nabta

# COD Network — كل طلب → lead (بالتوازي مع Google Sheet). عبّي هاد الجوج فـ EasyPanel (خدمة API) فقط، ماشي فـ GitHub:
COD_NETWORK_ENABLED=true
COD_NETWORK_API_TOKEN=
# اختياري: SKU ثابت. إن تركت فارغاً، السيرفر يأخذ أول منتج من حساب COD Network تلقائياً.
# COD_NETWORK_DEFAULT_SKU=

# MaxMind — false = تعطيل كل فحوصات الاحتيال (للتشخيص فقط؛ أعد true بعد الإصلاح)
MAXMIND_ENABLED=true

# MaxMind minFraud Score — Account ID + License Key (عبّيهم في EasyPanel فقط، لا في GitHub)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_ALLOWED_COUNTRY=SA
MAXMIND_MIN_RISK_SCORE_BLOCK=30
MAXMIND_BLOCK_VPN=true
MAXMIND_BLOCK_PROXY=true
MAXMIND_BLOCK_TOR=true
MAXMIND_BLOCK_HOSTING=true
MAXMIND_FAIL_CLOSED=false

# أرقام اختبار تتجاوز فحص MaxMind في الإنتاج (مفصول بفاصلة)
ORDER_TEST_PHONE_WHITELIST=055000000

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=

SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

TRACKING_ENABLED=true

CAPI_INGEST_SECRET=

# ─── لوحة التحكم Admin (واجهة HTML في `/api/admin`، اختصار `/admin`) ───
ADMIN_ENABLED=true
ADMIN_USERNAME=nabta_admin
ADMIN_PASSWORD=غيّر_كلمة_السر
ADMIN_SESSION_SECRET=غيّر_سِرّ_توقيع_طويل_عشوائي
# الكعكة HttpOnly — القيمة الفارغة = تلقائي: Secure=true فقط مع HTTPS أو X-Forwarded-Proto=https (موصى به).
# true صريحًا على HTTP المحلي يمنع المتصفّح من حفظ الجلسة ⇒ يبدو أن تسجيل الدخول لا يعمل.
# false يفرض السماح بدون Secure (اختبار محلي فقط على http).
ADMIN_COOKIE_SECURE=
# حاسبة الربح في لوحة Admin: تحويل AOV من ر.س إلى USD (مثال: 3.75 ر.س = 1 USD)
SAR_PER_USD=3.75

# جمع الزيارات من المتجر — POST /api/analytics/collect
# إن عيّنت سرّاً هنا، يجب أن يطابق القيمة في الواجهة NEXT_PUBLIC_ANALYTICS_SECRET (رأس X-Analytics-Secret)
ANALYTICS_INGEST_SECRET=

# منصة ثانية لاكتشاف VPN/بروكسي (اختياري لكن مُستحسَن مع MaxMind)
IPQUALITYSCORE_API_KEY=

# ضبط ما يُعتبر «نقرة موثوقة» في التحليلات (منفصل قليلاً عن حظر الطلبات)
# أقصى risk score من MaxMind يُسمح به لعدّ النقرة موثوقة (يُرفض عند >=)
ANALYTICS_MM_MAX_RISK_SCORE=30
ANALYTICS_MM_BLOCK_VPN=true
ANALYTICS_MM_BLOCK_PROXY=true
ANALYTICS_MM_BLOCK_TOR=true
ANALYTICS_MM_BLOCK_HOSTING=true
ANALYTICS_IPQS_BLOCK_VPN=true
ANALYTICS_IPQS_BLOCK_PROXY=true
ANALYTICS_IPQS_BLOCK_TOR=true
