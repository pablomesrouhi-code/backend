APP_ENV=production
API_BASE_URL=https://api.nabtalabo.store
FRONTEND_URL=https://Nabtalabo.store
# Ajoute https://www.Nabtalabo.store si tu utilises un sous-domaine www en production
CORS_ORIGINS=https://Nabtalabo.store

# SQL interne EasyPanel : postgres:// ou postgresql:// — normalisé en postgresql+psycopg au démarrage.
# Remplace CHANGE_ME par le mot de passe réel (ne jamais committer .env).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@nabtalabo_database:5432/nabtalabo?sslmode=disable
# Docker Compose local (DB seule, port hôte 5433) :
# DATABASE_URL=postgresql+psycopg://postgres:localdev_only@127.0.0.1:5433/nabtalabo?sslmode=disable

# true / 1 = ne pas lancer alembic au démarrage de l’API (debug / maintenance uniquement)
SKIP_AUTO_MIGRATE=false

GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_ALLOWED_COUNTRY=SA
MAXMIND_MIN_RISK_SCORE_BLOCK=30
MAXMIND_BLOCK_VPN=true
MAXMIND_BLOCK_PROXY=true
MAXMIND_BLOCK_TOR=true
MAXMIND_BLOCK_HOSTING=true
MAXMIND_FAIL_CLOSED=false

ORDER_TEST_PHONE_WHITELIST=055000000
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=

SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

TRACKING_ENABLED=true

CAPI_INGEST_SECRET=
