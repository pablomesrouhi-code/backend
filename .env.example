# ─── Nabtalabo — Backend (EasyPanel / Docker) ───
# انسخ إلى متغيرات البيئة في لوحة التحكم. لا ترفع أبداً ملف .env الحقيقي إلى GitHub.

APP_ENV=production

# عناوين عامة (يجب أن تطابق الدومينات الفعلية)
API_BASE_URL=https://api.nabtalabo.store
FRONTEND_URL=https://Nabtalabo.store

# إن تركت هذا فارغاً، السيرفر يدمج تلقائياً FRONTEND_URL + دومينات المتجر المعروفة + localhost للتطوير.
# إن عبيت قائمة صريحة، تُستخدم وحدها (وضع صارم).
# CORS_ORIGINS=https://Nabtalabo.store,https://www.Nabtalabo.store,http://localhost:3000

# EasyPanel: استعمل الرابط الداخلي لـ Postgres (حوّل postgres:// إلى postgresql+psycopg:// إن لزم).
# مثال شكل: postgresql+psycopg://USER:PASSWORD@nabtalabo_database:5432/nabtalabo?sslmode=disable
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@nabtalabo_database:5432/nabtalabo?sslmode=disable

SKIP_AUTO_MIGRATE=false

# Google Sheets — رابط Web App (/exec). إعادة المحاولة: GOOGLE_SHEET_WEBHOOK_RETRIES (افتراضي 5).
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwuxJpVRqW9x9R5_cj8z9KElthXcGYZKxQ0_g1kei0beOEVABdeoQaxP7XG7nDYYJ3J/exec


# MaxMind — false = تعطيل كل فحوصات الاحتيال (للتشخيص فقط؛ أعد true بعد الإصلاح)
MAXMIND_ENABLED=true

# MaxMind minFraud Score — HTTP Basic: Account ID + License Key
MAXMIND_ACCOUNT_ID=1342927
MAXMIND_LICENSE_KEY=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
MAXMIND_ALLOWED_COUNTRY=SA
MAXMIND_MIN_RISK_SCORE_BLOCK=30
MAXMIND_BLOCK_VPN=true
MAXMIND_BLOCK_PROXY=true
MAXMIND_BLOCK_TOR=true
MAXMIND_BLOCK_HOSTING=true
MAXMIND_FAIL_CLOSED=false

# أرقام اختبار تتجاوز فحص MaxMind في الإنتاج (مفصول بفاصلة)
ORDER_TEST_PHONE_WHITELIST=055000000

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=

SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

TRACKING_ENABLED=true

CAPI_INGEST_SECRET=
